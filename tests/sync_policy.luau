local s=SyncPolicy.new()
assert(SyncPolicy.due(s,0)); SyncPolicy.sent(s,0)
assert(not SyncPolicy.due(s,1.99) and SyncPolicy.due(s,2))
assert(SyncPolicy.full(s,1,2) and s.loaded and s.versioned and s.revision==1)
assert(not SyncPolicy.behind(s) and SyncPolicy.tick(s,1)=="current")
assert(SyncPolicy.tick(s,0)=="stale" and not SyncPolicy.full(s,0,3))
assert(not SyncPolicy.full(s,1,3),"Duplicate snapshots cannot overwrite newer tick values")
assert(SyncPolicy.tick(s,3)=="gap" and SyncPolicy.behind(s))
assert(SyncPolicy.tick(s,1)=="stale", "A reordered tick behind the observed target is stale")
assert(not SyncPolicy.due(s,4.9) and SyncPolicy.due(s,5)); SyncPolicy.sent(s,5)
assert(SyncPolicy.full(s,2,5.2) and SyncPolicy.behind(s),"A partial catch-up must retain the newer observed target")
assert(not SyncPolicy.due(s,9.9) and SyncPolicy.due(s,10)); SyncPolicy.sent(s,10)
assert(SyncPolicy.full(s,4,10.2) and not SyncPolicy.behind(s))
assert(SyncPolicy.tick(s,3)=="stale" and not SyncPolicy.full(s,2,11))
assert(not SyncPolicy.due(s,40.1) and SyncPolicy.due(s,40.2)); SyncPolicy.sent(s,40.2)
assert(not SyncPolicy.due(s,55.19) and SyncPolicy.due(s,55.2),"Periodic retry is bounded when the server is unavailable")
SyncPolicy.sent(s,55.2); assert(SyncPolicy.due(s,1),"Backward clocks must not permanently block recovery")
assert(not SyncPolicy.due(s,0/0) and not SyncPolicy.due(s,math.huge))
assert(SyncPolicy.tick(s,0/0)=="stale" and not SyncPolicy.full(s,nil,56))
local legacy=SyncPolicy.new(); assert(SyncPolicy.full(legacy,nil,1) and not legacy.versioned)
assert(SyncPolicy.tick(legacy,nil)=="unknown" and not SyncPolicy.due(legacy,30.9) and SyncPolicy.due(legacy,31))
assert(SyncPolicy.full(legacy,1,32) and legacy.versioned)
assert(not SyncPolicy.full(legacy,nil,33),"Missing revision must not roll back a versioned session")
print("Sync gap detection, stale ordering, retry pacing, clock rollback and legacy behavior passed")
