assert(PersistenceStatus.describe(nil,100).state=="unavailable")
assert(PersistenceStatus.describe({memory=true},100).state=="temporary")
assert(PersistenceStatus.describe({lastSuccess=100},174.99).state=="connected")
local delayed=PersistenceStatus.describe({lastSuccess=100,token="private",busy=true},175)
assert(delayed.state=="delayed" and delayed.age==75 and delayed.token==nil and delayed.busy==nil)
assert(PersistenceStatus.describe({lastSuccess=100},220).state=="expired")
assert(PersistenceStatus.describe({lastSuccess=100,closing=true},180).state=="closing")
assert(PersistenceStatus.describe({lastSuccess=100},1).age==0)
assert(PersistenceStatus.describe({lastSuccess=0/0},1).state=="unavailable")
assert(PersistenceStatus.describe({lastSuccess=0},math.huge).state=="unavailable")
local s={}; assert(CheckpointRequest.begin(s,0))
assert(not CheckpointRequest.begin(s,100),"Only one manual checkpoint may be in flight")
CheckpointRequest.finish(s); assert(not CheckpointRequest.begin(s,59.99))
assert(CheckpointRequest.begin(s,60)); CheckpointRequest.finish(s)
assert(CheckpointRequest.begin(s,1),"Clock rollback must not cause a permanent cooldown")
CheckpointRequest.finish(s); assert(not CheckpointRequest.begin(s,0/0))
local other={}; assert(CheckpointRequest.begin(other,1),"Cooldowns are per session")
print("Persistence disclosure, privacy, memory mode, checkpoint cooldown and in-flight safety passed")
