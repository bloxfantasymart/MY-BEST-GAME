local allow={123,456}
assert(AdminService.authorized(allow,123) and AdminService.authorized(allow,456))
assert(not AdminService.authorized(allow,999) and not AdminService.authorized(allow,"123"))
assert(AdminService.plan(allow,999,{command="grantCash",target=1,amount=1},50)==nil)
assert(AdminService.plan({},123,{command="event",event="Storm"},50)==nil)
assert(AdminService.plan(allow,123,{command="grantCash",target=1,amount=-1},50)==nil)
assert(AdminService.plan(allow,123,{command="grantCash",target=1,amount=0/0},50)==nil)
assert(AdminService.plan(allow,123,{command="grantCash",target=1,amount=math.huge},50)==nil)
assert(AdminService.plan(allow,123,{command="grantCash",target="1",amount=5},50)==nil)
assert(AdminService.plan(allow,123,{command="grantCash",target=1,amount=1.5},50)==nil)
assert(AdminService.plan(allow,123,{command="grantCash",target=1,amount=1000000000001},50)==nil)
assert(AdminService.plan(allow,123,{command="grantCash",target=1,amount=100},50).amount==100)
assert(AdminService.plan(allow,123,{command="setCash",target=1,amount=0},50).amount==0)
assert(AdminService.plan(allow,123,{command="setRebirth",target=1,amount=101},50)==nil)
assert(AdminService.plan(allow,123,{command="setRebirth",target=1,amount=100},50).amount==100)
assert(AdminService.plan(allow,123,{command="grantPart",target=1,index=51,kind="Head"},50)==nil)
assert(AdminService.plan(allow,123,{command="grantPart",target=1,index=1,kind="Tail"},50)==nil)
assert(AdminService.plan(allow,123,{command="grantPart",target=1,index=50,kind="Legs"},50).kind=="Legs")
assert(AdminService.plan(allow,123,{command="event",event="Storm"},50).event=="Storm")
assert(AdminService.plan(allow,123,{command="event",event="Unknown"},50)==nil)
assert(AdminService.plan(allow,123,{command="kick",target=1},50).target==1)
assert(AdminService.plan(allow,123,{command="inspect",target=1},50).target==1)
assert(AdminService.plan(allow,123,{command="unknown",target=1},50)==nil)
print("Admin authorization and input validation tests passed")
