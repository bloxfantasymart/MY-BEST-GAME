local gate=ShutdownGate.new()
assert(not gate.closed and gate.pending==0)
assert(ShutdownGate.begin(gate,"a") and gate.pending==1)
assert(not ShutdownGate.begin(gate,"a") and gate.pending==1, "Duplicate join must not start twice")
assert(ShutdownGate.begin(gate,"b") and gate.pending==2)
assert(ShutdownGate.finish(gate,"a") and gate.pending==1)
assert(not ShutdownGate.finish(gate,"a") and gate.pending==1)
ShutdownGate.close(gate)
assert(gate.closed and not ShutdownGate.begin(gate,"c"))
assert(ShutdownGate.finish(gate,"b") and gate.pending==0)
assert(not ShutdownGate.begin(gate,"a"))
print("Shutdown gate duplicate-join and draining tests passed")
-- A departure that started before shutdown must remain tracked until its save finishes.
local other=ShutdownGate.new()
assert(ShutdownGate.beginDeparture(other,"player") and other.pendingDepartures==1)
assert(not ShutdownGate.beginDeparture(other,"player") and other.pendingDepartures==1)
assert(not ShutdownGate.drained(other,0))
ShutdownGate.close(other)
assert(not ShutdownGate.drained(other,0) and not ShutdownGate.drained(other,1))
assert(other.pendingDepartures==1 and not ShutdownGate.begin(other,"new"))
assert(ShutdownGate.finishDeparture(other,"player") and other.pendingDepartures==0)
assert(ShutdownGate.drained(other,0) and not ShutdownGate.drained(other,1))
assert(not ShutdownGate.finishDeparture(other,"player") and other.pendingDepartures==0)
-- A late PlayerRemoving callback can still drain safely after closure.
assert(ShutdownGate.beginDeparture(other,"late") and other.pendingDepartures==1)
assert(ShutdownGate.finishDeparture(other,"late") and other.pendingDepartures==0)
print("Shutdown departure bookkeeping tests passed")
