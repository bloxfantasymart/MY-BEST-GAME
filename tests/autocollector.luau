local state=AutoCollector.new(true,9,100)
assert(not state.enabled)
assert(not AutoCollector.set(state,true,9,100))
assert(not state.enabled)
assert(not AutoCollector.set(state,"true",10,100))
assert(AutoCollector.set(state,true,10,100) and state.enabled)
assert(not AutoCollector.due(state,10,109.9,100))
assert(AutoCollector.due(state,10,110,100) and state.nextAt==120)
assert(not AutoCollector.due(state,10,110,100))
assert(not AutoCollector.due(state,10,120,0.99) and state.nextAt==130)
assert(AutoCollector.due(state,10,145,1) and state.nextAt==155, "Never replay missed intervals")
assert(not AutoCollector.due(state,9,160,100) and not state.enabled, "Loss of unlock disables the collector")
assert(AutoCollector.set(state,true,10,200))
assert(AutoCollector.set(state,false,10,201))
assert(not AutoCollector.due(state,10,300,100))
local rejoin=AutoCollector.new(true,10,500)
assert(rejoin.enabled and not AutoCollector.due(rejoin,10,509,100))
assert(AutoCollector.due(rejoin,10,510,100))
print("Auto-collector unlock, interval, persistence defaults and no catch-up tests passed")
