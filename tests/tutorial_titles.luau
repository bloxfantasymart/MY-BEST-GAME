local state=Tutorial.new()
local parts={}
assert(state.step==1 and not Tutorial.advance(state,"collect",parts))
assert(state.step==1 and not Tutorial.advance(state,"buy",parts))
Tutorial.advance(state,"roll",parts); assert(state.step==2)
table.insert(parts,{kind="Head"}); Tutorial.advance(state,"buy",parts); assert(state.step==3)
table.insert(parts,{kind="Chest"}); table.insert(parts,{kind="Arms"}); Tutorial.advance(state,"buy",parts); assert(state.step==3)
table.insert(parts,{kind="Legs"}); Tutorial.advance(state,"buy",parts); assert(state.step==4)
table.remove(parts,4); Tutorial.reconcile(state,parts); assert(state.step==3)
table.insert(parts,{kind="Legs"}); Tutorial.advance(state,"buy",parts); assert(state.step==4)
Tutorial.advance(state,"place",parts); assert(state.step==4)
Tutorial.advance(state,"craft",parts); assert(state.step==5)
Tutorial.advance(state,"place",{}); assert(state.step==6)
assert(Tutorial.advance(state,"collect",{}) and state.step==7)
assert(not Tutorial.advance(state,"collect",{}) and state.step==7, "Completion reward must be once only")
assert(Titles.forRebirth(0)=="Rookie Roller")
assert(Titles.forRebirth(10)=="Sigma Grinder")
assert(Titles.forRebirth(25)=="Mewing Champion")
assert(Titles.forRebirth(50)=="Ohio Conqueror")
assert(Titles.forRebirth(100)=="Brainrot Overlord")
print("Tutorial action ordering, reward, and rebirth title tests passed")
